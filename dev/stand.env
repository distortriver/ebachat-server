# The stand's settings over dev/run/go/config.json, for both servers (sourced by run-go.sh and run-rust.sh).
run=${run:-$(cd "$(dirname "$0")" && pwd)/run/go}
mkdir -p "$run/data"
export MM_SQLSETTINGS_DRIVERNAME=postgres
export MM_SQLSETTINGS_DATASOURCE="postgres://mmuser:mmpass@localhost:5433/mattermost?sslmode=disable&connect_timeout=10"
export MM_SERVICESETTINGS_SITEURL=http://localhost:8065
export MM_SERVICESETTINGS_ENABLELOCALMODE=true
export MM_SERVICESETTINGS_LOCALMODESOCKETLOCATION=$run/mattermost_local.socket
export MM_TEAMSETTINGS_ENABLEOPENSERVER=true
export MM_TEAMSETTINGS_MAXUSERSPERTEAM=10000
export MM_PLUGINSETTINGS_ENABLE=false
export MM_FILESETTINGS_DIRECTORY=$run/data/
export MM_LOGSETTINGS_ENABLEFILE=false
export MM_LOGSETTINGS_CONSOLELEVEL=WARN
export MM_METRICSSETTINGS_ENABLE=false
# A source build of Go is "dev" unless told; say so to both.
export MM_SERVICEENVIRONMENT=dev
# The web client (dev/get-webapp.sh) the Rust server serves from /static and /; without it, only the system emoji
# images EBAChat loads from /static/emoji (the web client's sources, Apache-2.0).
dev=$(cd "$run/../.." && pwd)
if [ -d "$dev/client" ]; then
  export EBACHAT_CLIENT_DIR=${EBACHAT_CLIENT_DIR:-$dev/client}
else
  export EBACHAT_CLIENT_DIR=${EBACHAT_CLIENT_DIR:-$dev/../../ebac-messenger/mattermost/webapp/channels/src/images}
fi
